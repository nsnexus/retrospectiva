rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid}/leads/{cnpj} {
   function owner() { return request.auth != null && request.auth.uid == uid; }
   function shortText(s, limit) { return s is string && s.size() <= limit; }
   function date(s) { return s is string && (s == '' || s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
   function valid() {
    let d = request.resource.data;
    let c = d.company;
    return d.keys().hasAll(['company','status','notes','nextAttempt','lastContact','updatedAt'])
     && d.keys().hasOnly(['company','status','notes','nextAttempt','lastContact','updatedAt'])
     && c.keys().hasAll(['cnpj','name','cnae','sector','city','state','address','phone','email','opened','lat','lng'])
     && c.keys().hasOnly(['cnpj','name','cnae','sector','city','state','address','phone','email','opened','lat','lng'])
     && c.cnpj == cnpj && cnpj.matches('^[0-9A-Z]{12}[0-9]{2}$')
     && shortText(c.name,300) && shortText(c.cnae,7) && shortText(c.sector,300)
     && shortText(c.city,150) && shortText(c.state,2) && shortText(c.address,500)
     && shortText(c.phone,30) && shortText(c.email,254) && date(c.opened)
     && c.lat is number && c.lat >= -90 && c.lat <= 90 && c.lng is number && c.lng >= -180 && c.lng <= 180
     && d.status in ['Novo','Contatado','Respondeu','Interessado','Orçamento enviado','Cliente','Não tem interesse','Contato inválido']
     && shortText(d.notes,10000) && date(d.nextAttempt) && date(d.lastContact) && shortText(d.updatedAt,30);
   }
   allow read, delete: if owner();
   allow create, update: if owner() && valid();
  }
 }
}
